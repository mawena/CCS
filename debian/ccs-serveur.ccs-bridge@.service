[Unit]
Description=CCS — pont de %i (chats, fichiers, terminaux)
Documentation=man:ccs(1)
After=ccs-auth.service

[Service]
Type=simple
User=%i
ExecStart=/usr/bin/claude-accounts bridge --socket /run/ccs/bridge/%i/bridge.sock
SyslogIdentifier=ccs-bridge
Restart=on-failure
RestartSec=3
# SIGTERM au pont seul : il enregistre ses chats (ceux qui travaillent compris) puis arrête
# lui-même ses processus claude ; le reste n'est tué qu'au bout du délai
KillMode=mixed
TimeoutStopSec=30
