#!/usr/bin/make -f

%:
	dh $@

# Rien à compiler. Les tests (`make test`) sont lancés par scripts/build-deb.sh
# avant la construction : ils ont besoin d'un HOME et ne doivent pas tourner en root.
override_dh_auto_build:
override_dh_auto_test:
override_dh_auto_install:

override_dh_install:
	dh_install
	find debian/ccs*/usr -name __pycache__ -type d -prune -exec rm -rf {} +

# Unité systemd utilisateur du paquet ccs (debian/ccs.ccs-daemon.user.service) : installée
# et activée pour tous les utilisateurs.
override_dh_installsystemduser:
	dh_installsystemduser -pccs --name=ccs-daemon

# Services du serveur (paquet ccs-serveur) ; le pont est un gabarit démarré par ccs-auth.
override_dh_installsystemd:
	dh_installsystemd -pccs-serveur --name=ccs-auth
	dh_installsystemd -pccs-serveur --name=ccs-web
	dh_installsystemd -pccs-serveur --name=ccs-bridge@ --no-enable --no-start
