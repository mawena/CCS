[Unit]
Description=CCS — version web et API (127.0.0.1:8420, derrière nginx)
Documentation=man:ccs(1)
After=network.target ccs-auth.service
Wants=ccs-auth.service

[Service]
Type=simple
ExecStart=/usr/bin/claude-accounts web-serve
User=ccs-web
Group=ccs-web
SyslogIdentifier=ccs-web
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
