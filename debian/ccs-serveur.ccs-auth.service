[Unit]
Description=CCS — connexion au serveur (comptes Ubuntu, double authentification)
Documentation=man:ccs(1)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/claude-accounts auth-serve
User=root
SyslogIdentifier=ccs-auth
RuntimeDirectory=ccs
RuntimeDirectoryPreserve=yes
StateDirectory=ccs
StateDirectoryMode=0700
ProtectSystem=strict
ReadWritePaths=/var/lib/ccs /run/ccs
ProtectHome=read-only
PrivateTmp=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
